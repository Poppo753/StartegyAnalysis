# ============================================================
# CONFIGURAZIONE BACKTESTER
# ============================================================

# Directory dei dati OHLC generati dalla pipeline TypeScript
DATA_DIR=../data

# Directory di output per i risultati del backtest
OUTPUT_DIR=./backtest-results

# Simboli da testare (separati da virgola)
SYMBOLS=DCRUSDT

# Range di date (formato YYYY-MM-DD)
START_DATE=2026-01-01
END_DATE=2026-01-02

# Timeframe delle candele
TIMEFRAME=1s

# ============================================================
# PARAMETRI GRIGLIA DI RICERCA
# ============================================================

# --- Liste esplicite (separare valori con virgola) ---
# X: percentuale minima di salita per generare segnale
X_VALUES=0.2,0.5,1

# Y: finestra temporale in secondi per calcolare la salita
Y_VALUES=10,30,60

# Z: percentuale di discesa dal massimo per chiudere il trade
Z_VALUES=0.1,0.2,0.5

# --- Range automatici (formato start:end:step) ---
# Se valorizzati, hanno priorità su *_VALUES sopra.
# X e Z generano float (arrotondati a 6 decimali), Y genera int.
# X_RANGE=0.05:2.0:0.05
# Y_RANGE=5:600:5
# Z_RANGE=0.03:1.5:0.03

# Tempo massimo di mantenimento posizione (secondi)
MAX_HOLD_SECONDS=300

# ============================================================
# PARAMETRI TRADING
# ============================================================

# Capitale iniziale in USDT
INITIAL_CAPITAL=1000

# Dimensione posizione per trade in USDT
POSITION_SIZE=100

# Commissione per operazione (0.001 = 0.1%)
FEE_RATE=0.001

# Slippage stimato (0.0005 = 0.05%)
SLIPPAGE_RATE=0.0005

# Direzione: signal-only | long | short
DIRECTION=signal-only

# ============================================================
# ENGINE
# ============================================================

# Motore di backtest:
#   standard = motore Python leggibile e debuggabile (Fase 1)
#   fast = motore accelerato con Numba JIT (Fase 2)
#   gpu = screening GPU massivo + validazione anti-overfitting (Fase 3)
BACKTEST_ENGINE=standard

# Numero di top combinazioni per cui salvare i trades dettagliati (fast/gpu)
FAST_TOP_N=20

# ============================================================
# FASE 3 — GPU SCREENING + ANTI-OVERFITTING
# ============================================================

# Batch size per kernel GPU (combinazioni per batch)
GPU_BATCH_SIZE=2048

# Split temporale anti-overfitting
# TRAIN = periodo su cui cercare strategie
# VALIDATION = periodo su cui verificare (out-of-sample)
TRAIN_RATIO=0.7
VALIDATION_RATIO=0.3

# Filtri intelligenti (scarta strategie deboli dopo screening)
MIN_TRADES=20
MIN_WIN_RATE=40.0
MIN_PROFIT_FACTOR=1.2
MAX_DRAWDOWN_FILTER=30.0

# Salta tutti i filtri e mostra direttamente i risultati (true/false)
# Utile per debugging o per vedere tutte le strategie ranked
# SKIP_FILTERS=true

# Y Dinamico (discovery mode)
# Se true: Y non è nella griglia. Il sistema cerca il minimo nella finestra
# Y_MAX_WINDOW e verifica se il prezzo corrente è X% sopra quel minimo.
# La griglia diventa solo X × Z (molto più veloce).
# Output: avg_y_actual = quanti secondi ci ha messo mediamente il pump.
# Y_DYNAMIC=true
# Y_MAX_WINDOW=600