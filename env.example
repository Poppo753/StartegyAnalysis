# Comma-separated list of trading pairs
SYMBOLS=BTCUSDT

# Date range for historical data (YYYY-MM-DD)
START_DATE=2024-06-01
END_DATE=2024-06-02

# Output directory for downloaded data
OUTPUT_DIR=./data

# Binance API base URL
BINANCE_BASE_URL=https://api.binance.com

# Delay between API requests in milliseconds (per-request minimum gap)
REQUEST_DELAY_MS=100

# Number of days to download in parallel per symbol (REST API fallback)
CONCURRENT_DAYS=5

# Number of concurrent bulk file downloads from data.binance.vision
CONCURRENT_BULK_DOWNLOADS=10

# Global rate limit: max requests per minute (Binance limit is 1200, leave margin)
MAX_REQUESTS_PER_MINUTE=500

# Gzip compression for raw data files (.jsonl.gz format, saves ~80% disk space)
USE_GZIP=true

# Structured JSON logging on stderr (machine-readable, ELK/Splunk/jq friendly)
JSON_LOGGING=false

# Log verbosity for JSON logs: debug < info < warn < error (default: info)
LOG_LEVEL=info

# Service name stamped on every JSON log line (multi-instance correlation)
LOG_SERVICE=ohlc-pipeline